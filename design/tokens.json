{
  "cell": {
    "font": "Monaspace Neon",
    "size": 13,
    "lineHeight": 1.35
  },
  "type": {
    "mono": "Monaspace Neon",
    "reading": "Mona Sans",
    "readingHeading": "Mona Sans (SemiBold, wider cut)"
  },
  "reading": {
    "size": 14,
    "lineHeight": 1.5
  },
  "roles": {
    "failure": 1,
    "pass": 2,
    "attention": 3,
    "driving": 5,
    "live": 6,
    "dim": 8
  },
  "themeKeys": {
    "brand": "greenroom-brand",
    "brandText": "greenroom-brand-text",
    "chromeTint": "greenroom-chrome-tint"
  },
  "spacing": {
    "unit": 4,
    "scale": [4, 8, 12, 16, 24, 32, 48]
  },
  "radii": {
    "sm": 4,
    "md": 6,
    "lg": 8
  },
  "motion": {
    "decode": {
      "maxMs": 300
    },
    "draw": {
      "maxMs": 250
    },
    "glide": {
      "response": 0.25,
      "dampingFraction": 0.86
    },
    "settle": {
      "response": 0.3,
      "dampingFraction": 0.9
    },
    "clickMark": {
      "ms": 800
    },
    "bootReveal": {
      "ms": 600
    },
    "spinner": {
      "frames": ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"],
      "intervalMs": 80,
      "reduceMotion": "…"
    },
    "loader": {
      "grid": 3,
      "cycleMs": 650,
      "stepMs": 90,
      "on": "█",
      "off": "░",
      "elapsedTickMs": 100,
      "reduceMotion": "grid frozen dim, timer still ticks"
    },
    "undoMs": 5000
  },
  "layout": {
    "wideMinColumns": 200,
    "mediumMinColumns": 140,
    "runsColumns": 32,
    "runsStripColumns": 3,
    "transcriptMinColumns": 56,
    "transcriptMaxColumns": 80,
    "screenMinColumns": 56
  }
}
