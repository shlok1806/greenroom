# Copy to .env and fill in. .env is gitignored; never commit a real key.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
GREENROOM_VERIFIER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Describes screenshots for the verifier. Unset: moonshotai/kimi-k3 (ADR 0020). "none": no describer.
# Faster candidate: meta/muse-glimmer-30b; the daemon turns its thinking off (ADR 0030).
GREENROOM_VISION_MODEL=moonshotai/kimi-k3
# Remote access (ADR 0021). The tunnel hostname that forwards to this daemon; unset keeps it local only.
# GREENROOM_PUBLIC_HOST=greenroom.example.com
# Bearer token remote clients send, at least 32 characters: openssl rand -hex 32
# GREENROOM_TOKEN=
